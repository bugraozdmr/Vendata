<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="action_new_query"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_query"
        android:shortcutShortLabel="@string/shortcut_new_query"
        android:shortcutLongLabel="@string/shortcut_new_query">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.vendata.vendata"
            android:targetClass="com.vendata.vendata.MainActivity">
            <extra
                android:name="some unique action key"
                android:value="action_new_query" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="action_upload_file"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_file"
        android:shortcutShortLabel="@string/shortcut_upload_file"
        android:shortcutLongLabel="@string/shortcut_upload_file">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.vendata.vendata"
            android:targetClass="com.vendata.vendata.MainActivity">
            <extra
                android:name="some unique action key"
                android:value="action_upload_file" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="action_connections"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_server"
        android:shortcutShortLabel="@string/shortcut_connections_short"
        android:shortcutLongLabel="@string/shortcut_connections">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.vendata.vendata"
            android:targetClass="com.vendata.vendata.MainActivity">
            <extra
                android:name="some unique action key"
                android:value="action_connections" />
        </intent>
    </shortcut>
</shortcuts>

